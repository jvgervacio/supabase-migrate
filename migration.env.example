# Supabase migration settings. Copy to migration.env and replace every <...> value.
#   cp migration.env.example migration.env && chmod 600 migration.env
#
# Never commit migration.env -- it holds live credentials. It is gitignored.

# ---------------------------------------------------------------------------
# Source: MySQL
# Run this script ON the database server and keep MYSQL_HOST=127.0.0.1.
# A remote host needs port 3306 opened, bind-address changed and a matching
# grant -- an SSH tunnel is easier than all three.
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=<YOUR_MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>
MYSQL_DATABASE=<YOUR_MYSQL_DATABASE>

# ---------------------------------------------------------------------------
# Target: Supabase Postgres
# Dashboard > Connect > Session pooler. Port MUST be 5432: 6543 is transaction
# mode, which has no session SET and no prepared statements, both of which
# pgloader needs. Passwords are percent-encoded for you -- paste them raw.
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=<YOUR_REGION>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<YOUR_PROJECT_REF>
SUPABASE_DB_PASSWORD=<YOUR_DB_PASSWORD>
SUPABASE_DB_NAME=postgres

# Schema to load the tables into. Leave empty to use pgloader's default, which
# is a schema named after the source database.
TARGET_SCHEMA=<YOUR_TARGET_SCHEMA>

# ---------------------------------------------------------------------------
# Source: Amazon S3
# The IAM user needs s3:ListBucket on the bucket and s3:GetObject on its
# contents. Key id is 20 chars, secret is 40 -- no quotes, no trailing spaces.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_REGION=us-east-1
SOURCE_BUCKET=<YOUR_S3_BUCKET>
# Only for temporary ASIA... keys. Leave empty for normal AKIA... keys.
AWS_SESSION_TOKEN=
# Migrate only keys under this prefix. Empty means the whole bucket.
SOURCE_PREFIX=

# ---------------------------------------------------------------------------
# Target: Supabase Storage
# Keys from Storage > S3 Configuration > Access keys. The access key id is
# 32 hex chars and the secret is 64 -- copy them separately, it is easy to
# paste the id onto the end of the secret.
# ---------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT=https://<YOUR_PROJECT_REF>.storage.supabase.co/storage/v1/s3
SUPABASE_REGION=<YOUR_PROJECT_REGION>
SUPABASE_ACCESS_KEY_ID=<YOUR_SUPABASE_ACCESS_KEY_ID>
SUPABASE_SECRET_ACCESS_KEY=<YOUR_SUPABASE_SECRET_ACCESS_KEY>
TARGET_BUCKET=<YOUR_SUPABASE_BUCKET>
# Prepended to every destination key. Empty keeps the source key unchanged.
TARGET_PREFIX=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Files larger than this fail the upload. Match your bucket's limit.
MAX_FILE_MB=50
# Parallel storage transfers. Lower this if Supabase starts returning 429.
WORKERS=8
